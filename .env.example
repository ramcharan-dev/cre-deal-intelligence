# ---- App ----
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# ---- Host ports (change if 3000/8000/5432 are taken) ----
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- PostgreSQL ----
# POSTGRES_HOST/PORT are for running the backend on the host; compose overrides them to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cre_deal_intel
POSTGRES_USER=cre
POSTGRES_PASSWORD=change-me

# ---- AI providers (optional until used) ----
LLM_PROVIDER=gemini
LLM_MODEL=

ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to one workspace (Console → Settings → Workspaces → ID)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Keep timeout x (retries + 1) under ~290s (frontend proxy limit)
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=1

# Email extraction provider: claude (default) or ollama (local, no API key).
# For ollama, run the Ollama app or `ollama serve` and `ollama pull <model>`. In Docker, the backend
# reaches it at host.docker.internal (set in docker-compose.yml).
EXTRACTION_PROVIDER=claude
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384

VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIMENSIONS=1024

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# ---- Gmail integration (optional) ----
# Google Cloud → APIs & Services: enable the Gmail API, create an OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Must be listed as an "Authorized redirect URI" on the OAuth client.
# Defaults to <first CORS origin>/api/gmail/oauth/callback, e.g. http://localhost:3000/api/gmail/oauth/callback
GOOGLE_REDIRECT_URI=
# ---- Copilot AI providers (optional until used) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
COPILOT_PROVIDER_ORDER=gemini,groq,deterministic
